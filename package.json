{
  "name": "code-contour",
  "version": "0.0.0-spike",
  "private": true,
  "type": "module",
  "main": "test/fixtures/sqlite-packaged-main.cjs",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "measure:poc-0": "CODECONTOUR_MEASUREMENT_OUTPUT=docs/poc-0-issue-13-measurements.json vitest run test/analysis-measurement.test.ts",
    "measure:repository": "CODECONTOUR_REQUIRE_REAL_MEASUREMENT=1 vitest run test/real-repository-measurement.test.ts",
    "measure:executor": "tsc --noEmit false --outDir /private/tmp/codecontour-spike-dist && node scripts/prepare-spike-dist.mjs && CODECONTOUR_SPIKE_DIST=/private/tmp/codecontour-spike-dist node scripts/measure-analyzer-executors.mjs",
    "verify:executor-measurement": "node scripts/verify-executor-measurement.mjs",
    "measure:sqlite-driver": "CODECONTOUR_SQLITE_MEASUREMENT_OUTPUT=docs/adr-002-sqlite-driver-measurements.json vitest run test/sqlite-driver-measurement.test.ts",
    "package:sqlite-spike": "electron-forge package --platform=darwin --arch=arm64",
    "smoke:sqlite-packaged": "node scripts/run-packaged-sqlite-smoke.mjs",
    "verify:sqlite-spike": "node scripts/verify-sqlite-spike.mjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "electron": "^44.4.3",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "ignore": "^7.0.9"
  }
}
